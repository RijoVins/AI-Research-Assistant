# ---------------------------------------------------------------------------
# LLM provider: pick ONE of the two options below.
# ---------------------------------------------------------------------------

# Option A: Groq (default). Free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Option B: any OpenAI-compatible API, e.g. OmniRoute, OpenRouter, Ollama, LM Studio.
# Setting LLM_BASE_URL switches the app to this option (Groq is then ignored).
# Copy the base URL, key and a model name from your provider's dashboard.
# LLM_BASE_URL=http://localhost:PORT/v1
# LLM_API_KEY=your_omniroute_api_key_here
# LLM_MODEL=model-name-from-your-dashboard
# LLM_PROVIDER_NAME=OmniRoute

# ---------------------------------------------------------------------------
# Optional overrides (defaults shown)
# ---------------------------------------------------------------------------
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=200
# TOP_K=4
# LLM_TEMPERATURE=0
# VECTOR_DB_DIR=./chroma_db
